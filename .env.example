# Embedded PostgreSQL is the zero-service development fallback. For deployment,
# set DATABASE_URL to a dedicated PostgreSQL database instead.
DATABASE_URL=
DATA_DIR=./data
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Required for seed: choose a unique password of at least 12 characters.
SEED_PASSWORD=
